# Local-only proxy settings
# HOST is fixed to 127.0.0.1 by server.js
HOST=127.0.0.1
PORT=8964

# domestic uses the China WorkBuddy install.
# international uses WorkBuddy AI.
WORKBUDDY_EDITION=domestic

# Full path to the unpacked codebuddy CLI for the selected edition.
# Example: C:\Path\WorkBuddyAI\resources\app.asar.unpacked\cli\bin\codebuddy
WORKBUDDY_CLI_PATH=

# Optional. Defaults to %USERPROFILE%\.workbuddy or %USERPROFILE%\.workbuddy-ai.
WORKBUDDY_CONFIG_DIR=

# Optional comma-separated override. Leave empty to use the edition defaults:
# domestic: hy3,glm-5.3-flash,deepseek-v4.1-flash,hy4-preview
# international: hy4-preview-f,deepseek-v4.1-flash
WORKBUDDY_BUILTIN_MODELS=

# Port of the desktop-hosted CLI that already has a signed-in session.
WORKBUDDY_HOST_PORT=60123
WORKBUDDY_BUILTIN_TIMEOUT_MS=180000

# Optional key required by Cline on /v1/*.
PROXY_API_KEY=

# The actual model API to forward to. Keep this empty until an upstream is configured.
# The default upstream protocol is OpenAI-compatible.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_PROTOCOL=openai

# Optional JSON object for mapping WorkBuddy model ids to upstream model ids.
# Example: {"deepseek-v4-pro":"deepseek-chat"}
MODEL_MAP_JSON={}

# Optional per-model upstream routing. When set, a matching model id is sent to its
# own base URL and key instead of UPSTREAM_BASE_URL. Accepts a WorkBuddy models.json
# (array of {id,url,apiKey}) or {"models":[...]}. The file is read at startup and is
# never logged; keep it outside version control.
# Example: MODEL_ROUTES_PATH=%USERPROFILE%\.workbuddy\models.json
MODEL_ROUTES_PATH=

# OpenAI-compatible request compatibility. Custom models keep reasoning_effort by default.
UPSTREAM_STRIP_VERBOSITY=true
UPSTREAM_STRIP_REASONING_SUMMARY=true
UPSTREAM_STRIP_REASONING_EFFORT=false
# passthrough | auto | max_tokens | max_completion_tokens
UPSTREAM_MAX_TOKENS_FIELD=passthrough
# openai | auto | openrouter | deepseek | together | zai | qwen | qwen-chat-template
UPSTREAM_THINKING_FORMAT=openai

REQUEST_TIMEOUT_MS=600000
# Idle timeout for an already-open upstream response body (default 120000).
# The proxy stops waiting and ends the response when upstream sends no bytes for this long.
# Set to 0 to disable and let a stalled stream wait out REQUEST_TIMEOUT_MS.
STREAM_IDLE_TIMEOUT_MS=120000
MODEL_CATALOG_PATH=./models.json
ALLOWED_ORIGINS=
# Optional comma-separated allowlist for inbound Cline custom headers.
# Sensitive transport headers (Authorization, Cookie, Host, Content-Type, etc.) are always blocked.
FORWARD_REQUEST_HEADERS=HTTP-Referer,X-Title
